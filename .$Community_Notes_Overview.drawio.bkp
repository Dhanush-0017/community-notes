  <diagram name="Algo" id="Q7Jp0c1AAMe8QcNocMJk">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2000" pageHeight="1330" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="algo-title" parent="1" style="text;html=1;fontSize=30;fontStyle=1;align=center;" value="Community Notes Algorithm" vertex="1">
          <mxGeometry height="50" width="1960" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="a-in" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=12;spacingRight=12;fontSize=21;rounded=1;arcSize=6;spacingLeft=16;" value="&lt;b&gt;&lt;font style=&quot;font-size:24px&quot;&gt;WHAT X USES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The notes people wrote&lt;br&gt;The ratings people gave&lt;br&gt;Each person&amp;#x27;s country group&lt;br&gt;&amp;nbsp;&lt;br&gt;No fact-check data. X never checks if a note is true; it only looks at ratings.&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#777777&quot;&gt;code: main.py, runner.py&lt;/font&gt;" vertex="1">
          <mxGeometry height="281" width="400" x="20" y="86.5" as="geometry" />
        </mxCell>
        <mxCell id="a-clean" parent="1" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f6fb0;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=12;spacingRight=12;fontSize=21;rounded=1;arcSize=6;spacingLeft=16;" value="&lt;b&gt;&lt;font style=&quot;font-size:24px&quot;&gt;STEP 1: REMOVE WEAK DATA&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Ignore people with fewer than 10 ratings&lt;br&gt;Ignore notes with fewer than 5 ratings&lt;br&gt;Merge people who always rate the same way (possible fake accounts)&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#777777&quot;&gt;code: run_prescoring()&lt;/font&gt;" vertex="1">
          <mxGeometry height="254" width="430" x="490" y="100" as="geometry" />
        </mxCell>
        <mxCell id="a-trust" parent="1" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c79a00;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=12;spacingRight=12;fontSize=21;rounded=1;arcSize=6;spacingLeft=16;" value="&lt;b&gt;&lt;font style=&quot;font-size:24px&quot;&gt;STEP 2: WHO TO TRUST&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Each person gets a trust score: how often their past ratings matched the final result&lt;br&gt;Only trusted people count (about 2 out of 3 right)&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#777777&quot;&gt;code: helpfulness_scores.py&lt;/font&gt;" vertex="1">
          <mxGeometry height="227" width="460" x="990" y="113.5" as="geometry" />
        </mxCell>
        <mxCell id="a-score" parent="1" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7a4fb0;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=12;spacingRight=12;fontSize=21;rounded=1;arcSize=6;spacingLeft=16;" value="&lt;b&gt;&lt;font style=&quot;font-size:24px&quot;&gt;STEP 3: SCORE EACH NOTE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The program learns which people usually disagree with each other&lt;br&gt;HIGH score: people who usually disagree BOTH like the note&lt;br&gt;LOW score: only one side likes it&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#777777&quot;&gt;code: mf_core_scorer.py, mf_expansion_scorer.py&lt;/font&gt;" vertex="1">
          <mxGeometry height="227" width="480" x="980" y="438" as="geometry" />
        </mxCell>
        <mxCell id="a-decide" parent="1" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2e8b3e;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=12;spacingRight=12;fontSize=21;rounded=1;arcSize=6;spacingLeft=16;" value="&lt;b&gt;&lt;font style=&quot;font-size:24px&quot;&gt;STEP 4: DECIDE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Score 0.40 or more: SHOWN&lt;br&gt;Score under 0.30, or liked by one side only: BLOCKED&lt;br&gt;In between: WAIT for more ratings&lt;br&gt;Decision is fixed after 2 weeks&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#777777&quot;&gt;code: scoring_rules.py&lt;/font&gt;" vertex="1">
          <mxGeometry height="227" width="460" x="1530" y="438" as="geometry" />
        </mxCell>
        <mxCell id="a-judges" parent="1" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=12;spacingRight=12;fontSize=21;rounded=1;arcSize=6;spacingLeft=16;" value="&lt;b&gt;&lt;font style=&quot;font-size:24px&quot;&gt;TWO JUDGES: the same program, run on different people&lt;/font&gt;&lt;/b&gt;&lt;br&gt;CORE judge: uses people from countries where Community Notes started (for example the USA)&lt;br&gt;EXPANSION judge: also uses people from countries where Community Notes started recently&lt;br&gt;A judge only decides a note if at least HALF of the note&amp;#x27;s ratings come from its own people&lt;br&gt;If both judges can decide, the CORE judge wins&lt;br&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#777777&quot;&gt;code: constants.py (group lists), scorer.py (the half rule)&lt;/font&gt;" vertex="1">
          <mxGeometry height="199" width="1100" x="670" y="780" as="geometry" />
        </mxCell>
        <mxCell id="algo-e0" edge="1" parent="1" source="a-in" style="endArrow=classic;endSize=10;html=1;strokeWidth=3;strokeColor=#333333;fontSize=17;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="a-clean" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="algo-e1" edge="1" parent="1" source="a-clean" style="endArrow=classic;endSize=10;html=1;strokeWidth=3;strokeColor=#333333;fontSize=17;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="a-trust" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="algo-e2" edge="1" parent="1" source="a-trust" style="endArrow=classic;endSize=10;html=1;strokeWidth=3;strokeColor=#333333;fontSize=17;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="a-score" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="algo-e3" edge="1" parent="1" source="a-score" style="endArrow=classic;endSize=10;html=1;strokeWidth=3;strokeColor=#333333;fontSize=17;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="a-decide" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="algo-e4" edge="1" parent="1" source="a-judges" style="endArrow=classic;endSize=10;html=1;strokeWidth=3;strokeColor=#333333;fontSize=17;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;" target="a-score" value="steps 3 and 4 run once per judge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Tweet" id="q9dbtRe0o3E2rTrcBOLa">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2000" pageHeight="1080" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="saudi-title" parent="1" style="text;html=1;fontSize=30;fontStyle=1;align=center;" value="&quot;SAUDI IS BURNING&quot;&amp;nbsp;" vertex="1">
          <mxGeometry height="190" width="1960" x="21" y="-130" as="geometry" />
        </mxCell>
        <mxCell id="s-rate" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=12;spacingRight=12;fontSize=21;rounded=1;arcSize=6;spacingLeft=16;fontFamily=Verdana;" value="&lt;b&gt;&lt;font style=&quot;font-size:24px&quot;&gt;1. PEOPLE RATED THE 4 NOTES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;263 people gave 456 ratings&lt;br&gt;Each rating: helpful, somewhat helpful, or not helpful" vertex="1">
          <mxGeometry height="217" width="360" x="10" y="77.5" as="geometry" />
        </mxCell>
        <mxCell id="s-clean" parent="1" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f6fb0;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=12;spacingRight=12;fontSize=21;rounded=1;arcSize=6;spacingLeft=16;" value="&lt;font face=&quot;Verdana&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size:24px&quot;&gt;2. WEAK DATA REMOVED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Only 21 people had too few ratings&lt;br&gt;Almost all ratings were kept&lt;/font&gt;" vertex="1">
          <mxGeometry height="156.5" width="380" x="435" y="107.75" as="geometry" />
        </mxCell>
        <mxCell id="s-which" parent="1" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c79a00;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=12;spacingRight=12;fontSize=21;rounded=1;arcSize=6;spacingLeft=16;fontFamily=Verdana;" value="&lt;b&gt;&lt;font style=&quot;font-size:24px&quot;&gt;3. WHICH JUDGE DECIDES?&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The CORE judge needs half of the ratings from its people&lt;br&gt;Here only about 1 in 5 ratings came from CORE people&lt;br&gt;So the CORE judge cannot decide" vertex="1">
          <mxGeometry height="199" width="440" x="880" y="86.5" as="geometry" />
        </mxCell>
        <mxCell id="s-core" parent="1" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=12;spacingRight=12;fontSize=21;rounded=1;arcSize=6;spacingLeft=16;dashed=1;fontColor=#888888;fontFamily=Verdana;" value="&lt;b&gt;&lt;font style=&quot;font-size:24px&quot;&gt;CORE JUDGE: SKIPPED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Not enough of its people rated these notes" vertex="1">
          <mxGeometry height="90" width="580" x="1400" y="60" as="geometry" />
        </mxCell>
        <mxCell id="s-exp" parent="1" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#2f6fb0;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=12;spacingRight=12;fontSize=21;rounded=1;arcSize=6;spacingLeft=16;strokeWidth=3.5;fontFamily=Verdana;" value="&lt;b&gt;&lt;font style=&quot;font-size:24px&quot;&gt;EXPANSION JUDGE: DECIDES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Most raters were from countries where Community Notes is new, probably the Middle East" vertex="1">
          <mxGeometry height="117" width="580" x="1400" y="200" as="geometry" />
        </mxCell>
        <mxCell id="s-score" parent="1" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#7a4fb0;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=12;spacingRight=12;fontSize=21;rounded=1;arcSize=6;spacingLeft=16;fontFamily=Verdana;" value="&lt;b&gt;&lt;font style=&quot;font-size:24px&quot;&gt;4. HOW THE JUDGE SCORED THE NOTES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;One group of raters (group 24) liked all 4 notes&lt;br&gt;Another group (group 13) was split&lt;br&gt;The judge looks for notes that people who usually disagree BOTH like" vertex="1">
          <mxGeometry height="172" width="600" x="1390" y="447" as="geometry" />
        </mxCell>
        <mxCell id="s-decide" parent="1" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2e8b3e;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=12;spacingRight=12;fontSize=21;rounded=1;arcSize=6;spacingLeft=16;fontFamily=Verdana;" value="&lt;b&gt;&lt;font style=&quot;font-size:24px&quot;&gt;5. THE DECISION&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Note 1 (person): BLOCKED&lt;br&gt;Note 2 (AI): BLOCKED&lt;br&gt;Note 3 (AI): WAITING for more ratings&lt;br&gt;Note 4 (person): SHOWN" vertex="1">
          <mxGeometry height="172" width="580" x="730" y="447" as="geometry" />
        </mxCell>
        <mxCell id="s-shown" parent="1" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2e8b3e;strokeWidth=2.5;align=left;verticalAlign=top;spacingTop=12;spacingRight=12;fontSize=21;rounded=1;arcSize=6;spacingLeft=16;strokeWidth=4;fontFamily=Verdana;" value="&lt;b&gt;&lt;font style=&quot;font-size:24px&quot;&gt;6. SHOWN ON X&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Note 4 appeared under the tweet&lt;br&gt;7.5 hours after the tweet was posted&lt;br&gt;Written by a person: their first note ever&lt;br&gt;It beat 2 notes from the most active AI writers on X" vertex="1">
          <mxGeometry height="172" width="620" x="710" y="720" as="geometry" />
        </mxCell>
        <mxCell id="saudi-e0" edge="1" parent="1" source="s-rate" style="endArrow=classic;endSize=10;html=1;strokeWidth=3;strokeColor=#333333;fontSize=17;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="s-clean" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saudi-e1" edge="1" parent="1" source="s-clean" style="endArrow=classic;endSize=10;html=1;strokeWidth=3;strokeColor=#333333;fontSize=17;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="s-which" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saudi-e2" edge="1" parent="1" source="s-which" style="endArrow=classic;endSize=10;html=1;strokeWidth=3;strokeColor=#333333;fontSize=17;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;strokeColor=#b3b3b3;fontColor=#888888;" target="s-core" value="not enough">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saudi-e3" edge="1" parent="1" source="s-which" style="endArrow=classic;endSize=10;html=1;strokeWidth=3;strokeColor=#333333;fontSize=17;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="s-exp" value="this one">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saudi-e4" edge="1" parent="1" source="s-exp" style="endArrow=classic;endSize=10;html=1;strokeWidth=3;strokeColor=#333333;fontSize=17;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="s-score" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saudi-e5" edge="1" parent="1" source="s-score" style="endArrow=classic;endSize=10;html=1;strokeWidth=3;strokeColor=#333333;fontSize=17;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="s-decide" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="saudi-e6" edge="1" parent="1" source="s-decide" style="endArrow=classic;endSize=10;html=1;strokeWidth=3;strokeColor=#333333;fontSize=17;labelBackgroundColor=#ffffff;" value="Note 4">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1020" y="710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
